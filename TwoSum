#include<bits/stdc++.h>
using namespace std;

class Solution{
    public: 
        
    vector<int> twoSum(vector<int>&vec, int target){
        unordered_map<int, int>mp;
        int n = vec.size();
        for(int i = 0; i < n; i++){
            int checkElementPresentintheMap = target - vec[i];
            if(mp.find(checkElementPresentintheMap) != mp.end()){
                return {mp[checkElementPresentintheMap], i};
            }
           mp.insert({vec[i], i});
            
        }
        return {};
    }
};


int main(){
    Solution  s;
      cout<<"Enter n: ";
    int n;
    cin>>n;
    vector<int>vec(n);
    for(int i = 0; i < n; i++){
        cout<<"Enter i:"<<i + 1<<endl;
        cin>>vec[i];
    }
    cout<<"Enter Target: ";
    int target;
    
    cin>>target;
    vector<int>ans = s.twoSum(vec, target);
   for(int x : ans) {
        cout << x << " ";
    }
    return 0;
    
    
    
    
}
